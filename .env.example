# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram Chat ID or Channel Username (e.g. -1001234567890 or @your_channel)
TELEGRAM_CHAT_ID=@your_channel_or_chat_id

# Target Media RSS feed URL
FEED_URL=https://www.adultdvdempire.com/new-release-porn-videos.html?format=MRSS

# Maximum new entries to post in a single run (to prevent spam/rate limiting)
MAX_POSTS_PER_RUN=10

# If running for the first time with an empty history, how many items to send initially
# (Set to 0 for unlimited / post all items in the feed)
INITIAL_POST_LIMIT=0

# Maximum number of past item IDs to remember in history.json
MAX_HISTORY_SIZE=1000

# Path to the history tracking file
HISTORY_FILE=data/history.json

# Polling interval in seconds when running in loop mode or server runner (e.g. 1800 = 30 minutes)
POLL_INTERVAL_SECONDS=1800

# Run background bot thread inside server.py (useful for Render web service)
RUN_BOT=true

# Optional cron secret token for /poll endpoint
CRON_SECRET=

# Remote state tracking via GitHub Gist (persists history across Render deploys & restarts)
# GIST_TOKEN: GitHub Personal Access Token with 'gist' scope (classic or fine-grained)
GIST_TOKEN=
# GIST_ID: GitHub Gist ID (leave empty on first run to have the bot auto-create a private gist)
GIST_ID=
# GIST_FILENAME: File name inside the gist (default: history.json)
GIST_FILENAME=history.json
